# Copy this file to .env and fill it in. Never commit .env, and never paste your key into chat or code.
NVIDIA_API_KEY=nvapi-paste-your-key-here

# Any chat model on build.nvidia.com that supports tool calling.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Reasoning: on | medium | off. "medium" thinks less (faster, fewer tokens).
NVIDIA_THINKING=on

# Sampling. These match the values on NVIDIA's model card. If tool calls get flaky, try 0.6.
NVIDIA_TEMPERATURE=1.0
NVIDIA_TOP_P=0.95

# Upper limit on tokens per model call, reasoning included.
NVIDIA_MAX_TOKENS=16384

# How many times to retry when NVIDIA says the service is busy. Waits grow: ~5s, 15s, 45s, 120s.
NVIDIA_RETRIES=4

# Hard cap on model calls per run.
AGENT_MAX_STEPS=30
